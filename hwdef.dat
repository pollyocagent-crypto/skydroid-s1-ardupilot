# Skydroid S1, vendor application layout. Application only.
MCU STM32H7xx STM32H743xx
OSCILLATOR_HZ 16000000
STM32_ST_USE_TIMER 5
APJ_BOARD_ID 2003
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
STORAGE_FLASH_PAGE 14
define HAL_STORAGE_SIZE 32768
define HAL_STORAGE_BACKUP_FOLDER "/APM/STRG_S1_PLANE"
define HAL_BOARD_LOG_DIRECTORY "/APM/LOGS_S1_PLANE"
define AP_CRASHDUMP_ENABLED 0
define AP_BOOTLOADER_FLASHING_ENABLED 0

USB_VENDOR 0x1209
USB_PRODUCT 0x5741
USB_STRING_MANUFACTURER "SKYDROID"
USB_STRING_PRODUCT "MX450"
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
# Use the OTG device-mode B-session override instead of the VBUS detector.
define BOARD_OTG_NOVBUSSENS
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Preserve logical SERIAL numbers from the vendor SerialManager.
SERIAL_ORDER OTG1 USART2 USART1 UART7 USART3 UART4
PD5 USART2_TX USART2
PD6 USART2_RX USART2
PB14 USART1_TX USART1
PB15 USART1_RX USART1
PE8 UART7_TX UART7
PA8 UART7_RX UART7
PB10 USART3_TX USART3
PB11 USART3_RX USART3
PA0 UART4_TX UART4
PA1 UART4_RX UART4
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL1_BAUD 921
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL2_BAUD 38
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_None
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_None
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_None

# Timer capture with standard SBUS polarity.
PA15 TIM2_CH1 TIM2 RCININT

PE9 TIM1_CH1 TIM1 PWM(1) NODMA
PE11 TIM1_CH2 TIM1 PWM(2) NODMA
PE13 TIM1_CH3 TIM1 PWM(3) NODMA
PE14 TIM1_CH4 TIM1 PWM(4) NODMA
PB6 TIM4_CH1 TIM4 PWM(5) NODMA
PB7 TIM4_CH2 TIM4 PWM(6) NODMA
PD14 TIM4_CH3 TIM4 PWM(7) NODMA
PD15 TIM4_CH4 TIM4 PWM(8) NODMA
PC6 TIM3_CH1 TIM3 PWM(9) NODMA
PC7 TIM3_CH2 TIM3 PWM(10) NODMA
PB0 TIM3_CH3 TIM3 PWM(11) NODMA
PB1 TIM3_CH4 TIM3 PWM(12) NODMA

PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA2 BMI088_ACC_CS CS
PA3 BMI088_GYR_CS CS
PE2 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4
PE4 MS5611_CS CS
SPIDEV bmi088_a SPI1 DEVID1 BMI088_ACC_CS MODE3 10*MHZ 10*MHZ
SPIDEV bmi088_g SPI1 DEVID2 BMI088_GYR_CS MODE3 10*MHZ 10*MHZ
SPIDEV ms5611 SPI4 DEVID1 MS5611_CS MODE3 20*MHZ 20*MHZ
IMU BMI088 SPI:bmi088_a SPI:bmi088_g ROTATION_PITCH_180
BARO MS5611 SPI:ms5611

# Leave vendor FRAM deselected, with no SPI2 driver or storage probe.
PD0 FRAM_CS CS

PD12 I2C4_SCL I2C4
PD13 I2C4_SDA I2C4
I2C_ORDER I2C4
define HAL_I2C_INTERNAL_MASK 0
define AP_COMPASS_PROBING_ENABLED 1

PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

# Enable the ArduPilot filesystem and file logger on SDMMC1.
define HAL_OS_FATFS_IO 1

# FDCAN1 on the factory AF9 pins, with classic DroneCAN at 1 Mbit/s.
PB8 CAN1_RX CAN1
PB9 CAN1_TX CAN1
CANFD_SUPPORTED 0
define HAL_CAN_DRIVER_DEFAULT 1

# Factory ADC channels and scale. Plane type 4 reads both voltage and current.
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC3 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 13
define HAL_BATT_VOLT_SCALE 31
define HAL_BATT_CURR_SCALE 20
define HAL_BATT_MONITOR_DEFAULT 4
