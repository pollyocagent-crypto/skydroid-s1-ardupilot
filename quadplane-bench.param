# Bench tilt-tri. Confirm directions, travel and ESC PWM range on the airframe.
# TIM1 (PWM 1-4): normal motor PWM, 400 Hz. TIM4/3 (PWM 5-12): servos, 50 Hz.
# Preserve the tested installation layout: right/left tilt on 5/6, ailerons on 7/8,
# left/right V-tail on 9/10. Save SERVO11_FUNCTION=0 explicitly on a TRI board
# that reports the firmware default of 39. The front tilts supply vectored yaw.
# Verify PWM11 after an authorized restart; a live write can leave prior PWM latched.
# See WIRING.md for physical markup and the complete output layout.
SERIAL0_PROTOCOL,2
SERIAL1_PROTOCOL,2
SERIAL1_BAUD,921
SERIAL1_OPTIONS,0
SERVO_RATE,50
Q_ENABLE,1
Q_FRAME_CLASS,7
Q_FRAME_TYPE,1
Q_M_PWM_TYPE,0
Q_M_PWM_MIN,1000
Q_M_PWM_MAX,2000
Q_RC_SPEED,400
Q_TILT_ENABLE,1
Q_TILT_TYPE,2
Q_TILT_MASK,3
Q_TILT_MAX,35
Q_TILT_RATE_DN,10
Q_TILT_RATE_UP,15
Q_TILT_YAW_ANGLE,15
Q_TILT_FIX_ANGLE,0
Q_TILT_FIX_GAIN,0
Q_TILT_WING_FLAP,0
SERVO1_FUNCTION,33
SERVO2_FUNCTION,34
SERVO3_FUNCTION,36
SERVO4_FUNCTION,0
SERVO5_FUNCTION,76
SERVO6_FUNCTION,75
SERVO7_FUNCTION,4
SERVO8_FUNCTION,4
SERVO9_FUNCTION,79
SERVO10_FUNCTION,80
SERVO11_FUNCTION,0
SERVO12_FUNCTION,0
